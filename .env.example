# WebMCP Guardian — environment for the OPTIONAL "Real AI agent (OpenAI)" mode.
# Copy to .env (Vercel: set these as Project → Settings → Environment Variables). NEVER commit a real key.
# The scripted simulator and the entire Guardian security layer need NONE of this — they run offline.
# Only api/agent.js (the serverless proxy that relays one Chat Completions call) reads these.

# Server-side OpenAI key. Kept server-side; never shipped to the browser. If unset, the panel falls back
# to a bring-your-own-key field (forwarded once to the same-origin proxy, never stored).
OPENAI_API_KEY=sk-your-key-here

# Optional. Default is gpt-4o-mini. On the SERVER key path the proxy pins the model to a small allowlist
# (gpt-4o-mini / gpt-4.1-mini / gpt-4o) to guard against denial-of-wallet; a client-chosen model is
# honored only with a bring-your-own key. Confirm this id exists on your OpenAI account before deploying.
OPENAI_MODEL=gpt-4o-mini
